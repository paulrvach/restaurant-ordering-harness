{
  "name": "restaurant-ordering-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run evals web/convex web/src/server",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm --prefix social run check && npm --prefix web run check",
    "demo": "tsx scripts/demo.ts",
    "dev": "node scripts/dev-web.mjs",
    "social": "npm --prefix social run compose --",
    "eval:live": "node --env-file=.env --import tsx scripts/eval-live.ts"
  },
  "dependencies": {
    "@mastra/core": "1.81.0",
    "assistant-stream": "0.3.55",
    "convex": "^1.49.0",
    "decimal.js": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "22.20.5",
    "convex-test": "^0.0.66",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
