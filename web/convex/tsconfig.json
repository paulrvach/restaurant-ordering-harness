{
  "compilerOptions": {
    "target": "ESNext", "lib": ["ES2023", "dom"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowJs": true, "isolatedModules": true, "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated", "./**/*.test.ts"]
}
